# dependencies
/node_modules
/.pnp
.pnp.js
.pnpm-store/
package-lock.json

#yarn
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
*.tsbuildinfo

# production
/build

# misc
.DS_Store
*.pem
/.idea
/.cursor/
!/.cursor/rules/project-specific/
/.vscode
/.history

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.development
.env.production

# vercel
.vercel

# personal KB link (path + preferences vary per collaborator — see repo-init skill)
.claude/kb-link.local.json

# local scratch for agent/skill outputs (kb-handoff screenshots, etc.)
.context/
