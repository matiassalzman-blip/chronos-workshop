[alias]
   squash-rebase = "!f() { \
       target_branch=\"$1\"; \
       if [ -z \"$target_branch\" ]; then \
            target_branch=\"develop\"; \
       fi; \
       git reset --soft HEAD~$(git rev-list --count HEAD ^\"$target_branch\") && \
       git commit -m \"$(git log --format=%B --reverse HEAD..HEAD@{1} | tail -n 2)\"; \
       git rebase \"$target_branch\"; \
}; f"
